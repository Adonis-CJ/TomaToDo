<?xml version="1.0" encoding="utf-8"?>
<!-- TomaTodo 应用图标前景：「番茄即钟」
     纸白背景上：朱砂番茄果体 + 松绿叶萼，果心嵌纸白表针（墨·纸设计语言）。
     viewport 108dp，全部内容置于 66dp 安全区内（中心 54,54）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
