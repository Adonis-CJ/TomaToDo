        android:pathData="M54,33.5 A24.5,24.5 0 1,1 53.99,33.5 Z" />

    <!-- 果体左侧微高光（深一号朱砂，塑造体积，克制不抢眼） -->
    <path
        android:fillColor="#A64B32"
        android:pathData="M40.5,45.5 A24.5,24.5 0 0,0 44,71.5 A24.5,24.5 0 0,1 40.5,45.5 Z" />

