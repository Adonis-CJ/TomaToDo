        android:pathData="M54,33.5 C53,29.5 53,26.5 54,23 C55,26.5 55,29.5 54,33.5 Z" />

    <!-- 表针（纸白 #FDFCF8）：分针向上、时针向右，圆头 -->
    <path
        android:strokeColor="#FDFCF8"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,58 L54,46.5" />
